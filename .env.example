# =============================================================================
# FESPA Coach AI — variabili d'ambiente
#
# 1. Copia questo file in .env.local
# 2. Compila i valori (vedi README, sezione "Variabili d'ambiente")
#
# .env.local è ignorato da git: non committare MAI chiavi o password.
# Le variabili NEXT_PUBLIC_* possono finire nel codice del browser:
# devono contenere solo valori pubblici per design.
# =============================================================================

# --- Applicazione ------------------------------------------------------------

# URL pubblico dell'app (in locale: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fuso orario per "oggi", scadenze e date mostrate (formato IANA)
APP_TIMEZONE=Europe/Rome

# --- Supabase ------------------------------------------------------------------
# Dashboard Supabase → Project Settings → API Keys

# URL del progetto, es. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chiave "anon" (legacy) oppure "publishable" (sb_publishable_...).
# È pubblica per design: i dati sono protetti dalla Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave "service_role" (legacy) oppure "secret" (sb_secret_...).
# SEGRETA: ignora la Row Level Security.
# Usata SOLO dallo script `npm run db:seed`. L'applicazione web non la legge mai.
SUPABASE_SERVICE_ROLE_KEY=

# Stringa di connessione al database, SOLO per `npm run db:migrate` (Supabase CLI).
# SEGRETA: contiene la password del database. L'applicazione web non la legge mai.
# Supabase → Connect → "Session pooler" (compatibile con IPv4): copia l'URI e sostituisci
# [YOUR-PASSWORD] con la password del database (anche con caratteri speciali: la codifica lo script).
# Es. postgresql://postgres.<ref>:<password>@aws-0-<regione>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Token personale Supabase, SOLO per `npm run email:templates` (carica i template email in Supabase Auth).
# SEGRETO: dà accesso al tuo account Supabase. Supabase → Account preferences → Access Tokens.
# Si può revocare subito dopo l'uso e ricrearlo quando serve.
SUPABASE_ACCESS_TOKEN=

# --- Dati demo (solo per `npm run db:seed`) ------------------------------------

# Password assegnata agli account demo creati dallo script (minimo 12 caratteri).
SEED_DEMO_PASSWORD=

# Dominio delle email demo (es. giulia.ferrante@example.com).
SEED_DEMO_EMAIL_DOMAIN=example.com

# --- Intelligenza artificiale ----------------------------------------------------

# Provider AI: "anthropic". Vuoto = AI disattivata (l'app funziona comunque).
AI_PROVIDER=

# Chiave API del provider (console.anthropic.com → API Keys). SEGRETA, solo server.
AI_API_KEY=

# Modello da usare. Default: claude-opus-5
AI_MODEL=claude-opus-5

# Solo se la chiave NON appartiene a un workspace (errore "not scoped to a workspace"):
# ID del workspace, es. wrkspc_... (console.anthropic.com → Settings → Workspaces).
AI_WORKSPACE_ID=

# true = risultati AI simulati (mock), dichiarati come tali nell'interfaccia.
# Utile per una demo senza chiave. Se true ha la precedenza su AI_PROVIDER.
DEMO_AI_MODE=false
