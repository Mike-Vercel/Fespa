{
  "name": "fespa-coach-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/supabase-db.ts push",
    "db:migrations": "tsx --env-file-if-exists=.env.local scripts/supabase-db.ts list",
    "db:mark-applied": "tsx --env-file-if-exists=.env.local scripts/supabase-db.ts mark-applied",
    "images:webp": "tsx scripts/images-to-webp.ts",
    "db:mark-reverted": "tsx --env-file-if-exists=.env.local scripts/supabase-db.ts mark-reverted",
    "email:templates": "tsx --env-file-if-exists=.env.local scripts/supabase-email-templates.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.3",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "^0.35.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
